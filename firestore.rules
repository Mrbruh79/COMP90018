rules_version = '2';

// Assumed data model for the existing Standard-edition default database:
// accountSettings/{uid}: private uid, verified email, optional opted-in phone hash,
// peerId and discoverableByPhone flag. Only the owner reads this document.
// accountCards/{uid}: uid, unique username, short display name and app peerId.
// Optional nearbyPublicKey: Base64 P-256 public key for that peer, 120-180 characters.
// privateProfiles/{uid}: owner-only card fields and discovery choice, with
// a client update time for reconciling local and account copies.
// usernames/{username}: one immutable UID reservation for each lowercase username.
// {emailLookup|phoneLookup|peerLookup}/{key}/accounts/{uid}: uid-only lookup entry.
// directChatsV2/{id}: two memberIds. privateChatsV2/{id}: ownerUid, name,
// revision, memberIds and matching member cards. Their messages carry senderUid,
// senderPeerId, senderName, text and sentAt. Legacy phone chat paths are closed.
// venues, events, event members and announcements retain their existing models.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountSignedIn() {
      return signedIn() && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '').size() > 0;
    }

    function isOwner(uid) {
      return accountSignedIn() && request.auth.uid == uid;
    }

    function uidUnchanged(uid) {
      return request.resource.data.uid == uid && uid == request.auth.uid;
    }

    function uidNotModified() {
      return request.resource.data.uid == resource.data.uid;
    }

    function validUid(value) {
      return value is string && value.size() > 0 && value.size() <= 128;
    }

    function validPeerId(value) {
      return value is string && value.matches('^[^/]{1,100}$');
    }

    function validUsername(value) {
      return value is string && value.matches('^[a-z0-9_]{3,20}$');
    }

    function validUsernameReservation(data, username) {
      return validUsername(username) && data.keys().hasAll(['uid'])
        && data.keys().hasOnly(['uid']) && data.uid == request.auth.uid
        && validUid(data.uid);
    }

    function validAccountSettings(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'phoneHash', 'peerId', 'discoverableByPhone'])
        && data.keys().hasOnly(['uid', 'email', 'phoneHash', 'peerId', 'discoverableByPhone'])
        && data.uid == uid && validUid(data.uid)
        && data.email is string && data.email.size() <= 120
        && data.email == (request.auth.token.get('email_verified', false) == true
          ? request.auth.token.get('email', '').lower() : '')
        && data.phoneHash is string
        && data.phoneHash.matches('^([0-9a-f]{64})?$')
        && data.discoverableByPhone is bool
        && (data.discoverableByPhone ? data.phoneHash.size() == 64 : data.phoneHash == '')
        && validPeerId(data.peerId);
    }

    function validAccountCard(data, uid) {
      return data.keys().hasAll(['uid', 'name', 'peerId', 'username'])
        && data.keys().hasOnly(['uid', 'name', 'peerId', 'username', 'nearbyPublicKey'])
        && (!('nearbyPublicKey' in data) || (data.nearbyPublicKey is string
          && data.nearbyPublicKey.size() >= 120 && data.nearbyPublicKey.size() <= 180
          && data.nearbyPublicKey.matches('^[A-Za-z0-9+/]+={0,2}$')))
        && data.uid == uid && validUid(data.uid)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 24
        && validUsername(data.username)
        && getAfter(/databases/$(database)/documents/usernames/$(data.username)).data.uid == uid
        && validPeerId(data.peerId)
        && getAfter(/databases/$(database)/documents/accountSettings/$(uid)).data.peerId == data.peerId;
    }

    function validPrivateProfile(data, uid) {
      return data.keys().hasAll([
          'uid', 'updatedAt', 'displayName', 'username', 'phoneNumber', 'email',
          'googleAccountEmail', 'discoverableByPhone', 'lookupPhoneNumber',
          'bio', 'websiteUrl', 'instagramUrl', 'xUrl', 'linkedinUrl', 'githubUrl'
        ])
        && data.keys().hasOnly([
          'uid', 'updatedAt', 'displayName', 'username', 'phoneNumber', 'email',
          'googleAccountEmail', 'discoverableByPhone', 'lookupPhoneNumber',
          'bio', 'websiteUrl', 'instagramUrl', 'xUrl', 'linkedinUrl', 'githubUrl'
        ])
        && data.uid == uid && validUid(data.uid)
        && data.updatedAt is int && data.updatedAt >= 0
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 24
        && validUsername(data.username)
        && data.phoneNumber is string && data.phoneNumber.matches('^([+][0-9]{8,15})?$')
        && data.email is string && data.email.size() <= 120
        && data.googleAccountEmail is string && data.googleAccountEmail.size() <= 120
        && data.discoverableByPhone is bool
        && data.lookupPhoneNumber is string
        && data.lookupPhoneNumber.matches('^([+][0-9]{8,15})?$')
        && (!data.discoverableByPhone || data.lookupPhoneNumber.size() > 0)
        && data.bio is string && data.bio.size() <= 240
        && data.websiteUrl is string && data.websiteUrl.size() <= 200
        && data.instagramUrl is string && data.instagramUrl.size() <= 200
        && data.xUrl is string && data.xUrl.size() <= 200
        && data.linkedinUrl is string && data.linkedinUrl.size() <= 200
        && data.githubUrl is string && data.githubUrl.size() <= 200;
    }

    function validLookup(data, uid) {
      return data.keys().hasAll(['uid']) && data.keys().hasOnly(['uid'])
        && data.uid == uid && validUid(data.uid);
    }

    function validDirect(data) {
      return data.keys().hasAll(['memberIds']) && data.keys().hasOnly(['memberIds'])
        && data.memberIds is list && data.memberIds.size() == 2
        && validUid(data.memberIds[0]) && validUid(data.memberIds[1])
        && data.memberIds[0] != data.memberIds[1]
        && data.memberIds[0] < data.memberIds[1];
    }

    function validGroupMember(member, uid) {
      return member is map && member.keys().hasAll(['uid', 'peerId', 'name'])
        && member.keys().hasOnly(['uid', 'peerId', 'name'])
        && member.uid == uid && validUid(member.uid)
        && validPeerId(member.peerId)
        && member.name is string && member.name.size() > 0 && member.name.size() <= 24;
    }

    function validGroupSlot(data, index) {
      return data.memberIds.size() <= index
        || (validUid(data.memberIds[index])
          && validGroupMember(data.members[index], data.memberIds[index]));
    }

    function validGroup(data) {
      return data.keys().hasAll(['name', 'ownerUid', 'revision', 'memberIds', 'members'])
        && data.keys().hasOnly(['name', 'ownerUid', 'revision', 'memberIds', 'members'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && validUid(data.ownerUid)
        && data.revision is int && data.revision >= 0
        && data.memberIds is list && data.memberIds.size() >= 2 && data.memberIds.size() <= 8
        && data.memberIds.toSet().size() == data.memberIds.size()
        && data.ownerUid in data.memberIds
        && data.members is list && data.members.size() == data.memberIds.size()
        && validGroupSlot(data, 0) && validGroupSlot(data, 1)
        && validGroupSlot(data, 2) && validGroupSlot(data, 3)
        && validGroupSlot(data, 4) && validGroupSlot(data, 5)
        && validGroupSlot(data, 6) && validGroupSlot(data, 7);
    }

    function validChatMessage(data) {
      return data.keys().hasAll(['senderUid', 'senderPeerId', 'senderName', 'text', 'sentAt'])
        && data.keys().hasOnly(['senderUid', 'senderPeerId', 'senderName', 'text', 'sentAt'])
        && data.senderUid == request.auth.uid && validUid(data.senderUid)
        && validPeerId(data.senderPeerId)
        && get(/databases/$(database)/documents/accountSettings/$(request.auth.uid)).data.peerId == data.senderPeerId
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 24
        && data.text is string && data.text.size() > 0 && data.text.size() <= 30000
        && data.sentAt is int && data.sentAt >= 0;
    }

    match /accountSettings/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && uidUnchanged(uid)
        && validAccountSettings(request.resource.data, uid);
      allow update: if isOwner(uid) && uidNotModified()
        && validAccountSettings(request.resource.data, uid);
      allow delete: if false;
    }

    match /privateProfiles/{uid} {
      allow get: if isOwner(uid);
      allow list, delete: if false;
      allow create: if isOwner(uid) && uidUnchanged(uid)
        && validPrivateProfile(request.resource.data, uid);
      allow update: if isOwner(uid) && uidNotModified()
        && validPrivateProfile(request.resource.data, uid);
    }

    match /accountCards/{uid} {
      allow get: if accountSignedIn();
      allow list: if false;
      allow create: if isOwner(uid) && uidUnchanged(uid)
        && validAccountCard(request.resource.data, uid);
      allow update: if isOwner(uid) && uidNotModified()
        && request.resource.data.username == resource.data.get('username', request.resource.data.username)
        && validAccountCard(request.resource.data, uid);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if accountSignedIn();
      allow list: if false;
      allow create: if accountSignedIn()
        && validUsernameReservation(request.resource.data, username);
      allow update, delete: if false;
    }

    match /emailLookup/{email}/accounts/{uid} {
      allow read: if accountSignedIn();
      allow create: if isOwner(uid) && validLookup(request.resource.data, uid)
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '').lower() == email
        && getAfter(/databases/$(database)/documents/accountSettings/$(uid)).data.email == email;
      allow update: if isOwner(uid) && validLookup(request.resource.data, uid)
        && request.resource.data == resource.data
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '').lower() == email
        && getAfter(/databases/$(database)/documents/accountSettings/$(uid)).data.email == email;
      allow delete: if isOwner(uid);
    }

    match /phoneLookup/{hash}/accounts/{uid} {
      allow read: if accountSignedIn();
      allow create: if isOwner(uid) && validLookup(request.resource.data, uid)
        && hash.matches('^[0-9a-f]{64}$')
        && getAfter(/databases/$(database)/documents/accountSettings/$(uid)).data.phoneHash == hash
        && getAfter(/databases/$(database)/documents/accountSettings/$(uid)).data.discoverableByPhone == true;
      allow update: if isOwner(uid) && validLookup(request.resource.data, uid)
        && request.resource.data == resource.data
        && getAfter(/databases/$(database)/documents/accountSettings/$(uid)).data.phoneHash == hash
        && getAfter(/databases/$(database)/documents/accountSettings/$(uid)).data.discoverableByPhone == true;
      allow delete: if isOwner(uid);
    }

    match /peerLookup/{peerId}/accounts/{uid} {
      allow read: if accountSignedIn();
      allow create: if isOwner(uid) && validLookup(request.resource.data, uid)
        && validPeerId(peerId)
        && getAfter(/databases/$(database)/documents/accountSettings/$(uid)).data.peerId == peerId;
      allow update: if isOwner(uid) && validLookup(request.resource.data, uid)
        && request.resource.data == resource.data
        && getAfter(/databases/$(database)/documents/accountSettings/$(uid)).data.peerId == peerId;
      allow delete: if isOwner(uid);
    }

    match /directChatsV2/{chatId} {
      allow read: if accountSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if accountSignedIn() && validDirect(request.resource.data)
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if accountSignedIn() && request.auth.uid in resource.data.memberIds
        && validDirect(request.resource.data) && request.resource.data == resource.data;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if accountSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/directChatsV2/$(chatId)).data.memberIds;
        allow create: if accountSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/directChatsV2/$(chatId)).data.memberIds
          && validChatMessage(request.resource.data);
        allow update: if accountSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/directChatsV2/$(chatId)).data.memberIds
          && validChatMessage(request.resource.data)
          && request.resource.data == resource.data;
        allow delete: if false;
      }
    }

    match /privateChatsV2/{chatId} {
      allow read: if accountSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if accountSignedIn() && validGroup(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if accountSignedIn() && validGroup(request.resource.data)
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.revision >= resource.data.revision;
      allow delete: if accountSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if accountSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/privateChatsV2/$(chatId)).data.memberIds;
        allow create: if accountSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/privateChatsV2/$(chatId)).data.memberIds
          && validChatMessage(request.resource.data);
        allow update: if accountSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/privateChatsV2/$(chatId)).data.memberIds
          && validChatMessage(request.resource.data)
          && request.resource.data == resource.data;
        allow delete: if false;
      }
    }

    function eventData(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function isEventAdmin(eventId) {
      return signedIn() && request.auth.uid in eventData(eventId).adminIds;
    }

    function isEventMember(eventId) {
      return signedIn() && request.auth.uid in eventData(eventId).memberIds;
    }

    function isActiveEventMember(eventId) {
      let membership = get(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid));
      return isEventMember(eventId) && membership.data.userId == request.auth.uid
        && membership.data.get('blockedAt', null) == null
        && membership.data.get('leftAt', null) == null;
    }

    function discussionWritable(eventId) {
      let event = eventData(eventId);
      return isActiveEventMember(eventId)
        && event.get('deletedAt', null) == null
        && request.time.toMillis() <= event.endsAt;
    }

    function validDiscussionBase(data, eventId, threadId, maximumLength) {
      return data.keys().hasAll([
          'eventId', 'threadId', 'parentId', 'ancestorIds', 'depth', 'authorId',
          'authorName', 'body', 'likeCount', 'replyCount', 'lastReplyId',
          'createdAt', 'deletedAt', 'deletedByAdmin'
        ])
        && data.keys().hasOnly([
          'eventId', 'threadId', 'parentId', 'ancestorIds', 'depth', 'authorId',
          'authorName', 'body', 'likeCount', 'replyCount', 'lastReplyId',
          'createdAt', 'deletedAt', 'deletedByAdmin'
        ])
        && data.eventId == eventId && data.threadId == threadId
        && data.authorId == request.auth.uid
        && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 24
        && data.body is string && data.body.size() > 0 && data.body.size() <= maximumLength
        && data.likeCount == 0 && data.replyCount == 0 && data.lastReplyId == ''
        && data.createdAt is int && data.createdAt >= 0
        && data.deletedAt == null && data.deletedByAdmin == false;
    }

    function validDiscussionRoot(data, eventId, threadId) {
      return validDiscussionBase(data, eventId, threadId, 2000)
        && data.parentId == null && data.ancestorIds == [] && data.depth == 0;
    }

    function validDiscussionReplyParent(data, eventId, threadId) {
      let root = get(/databases/$(database)/documents/events/$(eventId)/discussionThreads/$(threadId));
      let parent = get(/databases/$(database)/documents/events/$(eventId)/discussionThreads/$(threadId)/comments/$(data.parentId));
      return data.depth == 1
          && data.parentId == threadId
          && data.ancestorIds == [threadId]
          && root.data.get('deletedAt', null) == null
        || data.depth > 1
          && parent.data.threadId == threadId
          && parent.data.depth == data.depth - 1
          && parent.data.get('deletedAt', null) == null
          && data.ancestorIds[data.depth - 1] == data.parentId
          && !(data.parentId in parent.data.ancestorIds)
          && data.ancestorIds.toSet().hasAll(parent.data.ancestorIds.toSet())
          && data.ancestorIds.toSet().size() == parent.data.ancestorIds.size() + 1;
    }

    function validDiscussionReply(data, eventId, threadId, commentId) {
      let root = get(/databases/$(database)/documents/events/$(eventId)/discussionThreads/$(threadId));
      let rootAfter = getAfter(/databases/$(database)/documents/events/$(eventId)/discussionThreads/$(threadId));
      return validDiscussionBase(data, eventId, threadId, 1000)
        && data.parentId is string && data.parentId.size() > 0
        && data.ancestorIds is list && data.depth is int
        && data.depth > 0 && data.depth <= 20
        && data.ancestorIds.size() == data.depth
        && validDiscussionReplyParent(data, eventId, threadId)
        && rootAfter.data.replyCount == root.data.get('replyCount', 0) + 1
        && rootAfter.data.lastReplyId == commentId;
    }

    function validDiscussionReplyCounterIncrement(eventId, threadId) {
      let replyId = request.resource.data.lastReplyId;
      let replyPath = /databases/$(database)/documents/events/$(eventId)/discussionThreads/$(threadId)/comments/$(replyId);
      let replyAfter = getAfter(replyPath);
      return discussionWritable(eventId)
        && resource.data.parentId == null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['replyCount', 'lastReplyId'])
        && request.resource.data.replyCount == resource.data.get('replyCount', 0) + 1
        && replyId is string && replyId.size() > 0
        && !exists(replyPath) && existsAfter(replyPath)
        && replyAfter.data.eventId == eventId
        && replyAfter.data.threadId == threadId
        && replyAfter.data.authorId == request.auth.uid;
    }

    function validDiscussionAdminReplyCountUpdate(eventId) {
      return isEventAdmin(eventId)
        && resource.data.parentId == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        && request.resource.data.replyCount is int
        && request.resource.data.replyCount >= 0
        && request.resource.data.replyCount <= resource.data.get('replyCount', 0);
    }

    function validDiscussionSoftDelete(eventId) {
      return discussionWritable(eventId)
        && resource.data.authorId == request.auth.uid
        && resource.data.get('deletedAt', null) == null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['body', 'deletedAt', 'deletedByAdmin'])
        && request.resource.data.body == ''
        && request.resource.data.deletedAt is int
        && request.resource.data.deletedAt > 0
        && request.resource.data.deletedByAdmin == false;
    }

    function validDiscussionAdminRemoval(eventId) {
      return isEventAdmin(eventId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['body', 'deletedAt', 'deletedByAdmin'])
        && request.resource.data.body == ''
        && request.resource.data.deletedAt is int
        && request.resource.data.deletedAt > 0
        && request.resource.data.deletedByAdmin == true;
    }

    function discussionLikeExists(eventId, commentId) {
      let likeId = commentId + '_' + request.auth.uid;
      return exists(/databases/$(database)/documents/events/$(eventId)/discussionLikes/$(likeId));
    }

    function discussionLikeExistsAfter(eventId, commentId) {
      let likeId = commentId + '_' + request.auth.uid;
      return existsAfter(/databases/$(database)/documents/events/$(eventId)/discussionLikes/$(likeId));
    }

    function validDiscussionLikeCountUpdate(eventId, commentId) {
      return discussionWritable(eventId)
        && resource.data.get('deletedAt', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount is int && request.resource.data.likeCount >= 0
        && (
          request.resource.data.likeCount == resource.data.likeCount + 1
            && !discussionLikeExists(eventId, commentId)
            && discussionLikeExistsAfter(eventId, commentId)
          || request.resource.data.likeCount == resource.data.likeCount - 1
            && discussionLikeExists(eventId, commentId)
            && !discussionLikeExistsAfter(eventId, commentId)
        );
    }

    function validDiscussionLike(data, eventId, likeId) {
      return data.keys().hasAll(['eventId', 'threadId', 'commentId', 'userId', 'createdAt', 'isRoot'])
        && data.keys().hasOnly(['eventId', 'threadId', 'commentId', 'userId', 'createdAt', 'isRoot'])
        && data.eventId == eventId && data.userId == request.auth.uid
        && likeId == data.commentId + '_' + request.auth.uid
        && data.threadId is string && data.threadId.size() > 0
        && data.commentId is string && data.commentId.size() > 0
        && data.createdAt is int && data.createdAt >= 0
        && data.isRoot is bool;
    }

    function validDiscussionLikeCreate(data, eventId, likeId) {
      let root = get(/databases/$(database)/documents/events/$(eventId)/discussionThreads/$(data.threadId));
      let reply = get(/databases/$(database)/documents/events/$(eventId)/discussionThreads/$(data.threadId)/comments/$(data.commentId));
      let rootAfter = getAfter(/databases/$(database)/documents/events/$(eventId)/discussionThreads/$(data.threadId));
      let replyAfter = getAfter(/databases/$(database)/documents/events/$(eventId)/discussionThreads/$(data.threadId)/comments/$(data.commentId));
      return discussionWritable(eventId) && validDiscussionLike(data, eventId, likeId)
        && (
          data.isRoot == true && data.commentId == data.threadId
            && root.data.get('deletedAt', null) == null
            && rootAfter.data.likeCount == root.data.likeCount + 1
          || data.isRoot == false && data.commentId != data.threadId
            && reply.data.get('deletedAt', null) == null
            && replyAfter.data.likeCount == reply.data.likeCount + 1
        );
    }

    function validDiscussionLikeDelete(eventId) {
      let root = get(/databases/$(database)/documents/events/$(eventId)/discussionThreads/$(resource.data.threadId));
      let reply = get(/databases/$(database)/documents/events/$(eventId)/discussionThreads/$(resource.data.threadId)/comments/$(resource.data.commentId));
      let rootAfter = getAfter(/databases/$(database)/documents/events/$(eventId)/discussionThreads/$(resource.data.threadId));
      let replyAfter = getAfter(/databases/$(database)/documents/events/$(eventId)/discussionThreads/$(resource.data.threadId)/comments/$(resource.data.commentId));
      return discussionWritable(eventId) && resource.data.userId == request.auth.uid
        && (
          resource.data.isRoot == true
            && rootAfter.data.likeCount == root.data.likeCount - 1
          || resource.data.isRoot == false
            && replyAfter.data.likeCount == reply.data.likeCount - 1
        );
    }

    function isPublicEvent(eventId) {
      return eventData(eventId).visibility == 'PUBLIC';
    }

    function inviteId(eventId, uid) {
      return eventId + '_' + uid;
    }

    function acceptedInviteAfter(eventId, uid) {
      let invite = getAfter(/databases/$(database)/documents/eventInvitations/$(inviteId(eventId, uid))).data;
      return invite.eventId == eventId
        && invite.recipientUid == uid
        && invite.status == 'ACCEPTED'
        && invite.expiresAt >= request.time.toMillis();
    }

    function acceptingFreshInvite(eventId, uid) {
      let path = /databases/$(database)/documents/eventInvitations/$(inviteId(eventId, uid));
      let invite = get(path).data;
      let inviteAfter = getAfter(path).data;
      return invite.eventId == eventId
        && invite.recipientUid == uid
        && invite.status == 'PENDING'
        && inviteAfter.status == 'ACCEPTED'
        && inviteAfter.expiresAt >= request.time.toMillis();
    }

    function validEvent(data) {
      return data.keys().hasAll([
          'title', 'description', 'venueName', 'latitude', 'longitude', 'radiusMetres',
          'startsAt', 'endsAt', 'createdBy', 'adminIds', 'memberIds', 'adminPublicKeys',
          'visibility', 'requiresSignIn', 'privateMeshSecret', 'venueCheckInPayload',
          'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 80
        && data.description is string && data.description.size() <= 1000
        && data.venueName is string && data.venueName.size() <= 200
        && data.startsAt < data.endsAt
        && data.radiusMetres >= 20 && data.radiusMetres <= 5000
        && data.visibility in ['PUBLIC', 'PRIVATE']
        && data.requiresSignIn is bool
        && (data.visibility == 'PUBLIC' || data.requiresSignIn == false)
        && data.privateMeshSecret is string
        && (data.visibility == 'PUBLIC' && data.privateMeshSecret == ''
          || data.visibility == 'PRIVATE' && data.privateMeshSecret.size() >= 32)
        && data.venueCheckInPayload is string && data.venueCheckInPayload.size() <= 2000
        && data.get('searchTokens', []) is list
        && data.get('searchTokens', []).size() <= 200
        && data.get('geohash', '') is string
        && data.get('geohash', '').matches('^([0-9bcdefghjkmnpqrstuvwxyz]{0,12})$')
        && data.createdBy in data.adminIds
        && data.createdBy in data.memberIds
        && data.memberIds.hasAll(data.adminIds)
        && data.memberIds.size() <= 2000;
    }

    function selfMembershipOnlyChange(eventId) {
      let oldMembers = resource.data.memberIds;
      let newMembers = request.resource.data.memberIds;
      let onlyMembers = request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']);
      let joining = !(request.auth.uid in oldMembers)
        && request.auth.uid in newMembers
        && newMembers.size() == oldMembers.size() + 1
        && newMembers.hasAll(oldMembers)
        && (resource.data.visibility == 'PUBLIC'
          && (!resource.data.get('requiresSignIn', false) || accountSignedIn())
          || accountSignedIn() && acceptedInviteAfter(eventId, request.auth.uid));
      let leaving = request.auth.uid in oldMembers
        && !(request.auth.uid in newMembers)
        && oldMembers.size() == newMembers.size() + 1
        && oldMembers.hasAll(newMembers)
        && !(request.auth.uid in resource.data.adminIds);
      return signedIn() && onlyMembers && (joining || leaving);
    }

    match /venues/{venueId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if signedIn() && resource.data.visibility == 'PUBLIC'
        || accountSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if accountSignedIn()
        && validEvent(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.adminIds
        && request.resource.data.venueCheckInPayload.size() > 0
        && request.resource.data.memberIds == [request.auth.uid];
      allow update: if selfMembershipOnlyChange(eventId)
        || (isEventAdmin(eventId)
        && validEvent(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && resource.data.createdBy in request.resource.data.adminIds
        && request.resource.data.visibility == resource.data.visibility
        && (!request.resource.data.requiresSignIn || accountSignedIn())
        && request.resource.data.privateMeshSecret == resource.data.privateMeshSecret
        && (
          request.resource.data.venueCheckInPayload == resource.data.get('venueCheckInPayload', '')
          || request.auth.uid == resource.data.createdBy
            && resource.data.get('venueCheckInPayload', '') == ''
            && request.resource.data.venueCheckInPayload.size() > 0
        )
        && resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && request.resource.data.memberIds.size() <= resource.data.memberIds.size()
        && request.resource.data.get('updatedAt', 0) >= resource.data.get('updatedAt', 0)
        && (
          request.resource.data.get('deletedAt', null) == resource.data.get('deletedAt', null)
          || request.auth.uid == resource.data.createdBy
        ));
      allow delete: if signedIn() && request.auth.uid == resource.data.createdBy;

      match /members/{userId} {
        allow read: if signedIn() && isPublicEvent(eventId)
          || accountSignedIn() && (isEventMember(eventId) || isEventAdmin(eventId));
        allow create: if signedIn()
          && request.resource.data.userId == userId
          && (
            request.auth.uid == userId
              && request.auth.uid in getAfter(/databases/$(database)/documents/events/$(eventId)).data.memberIds
              && request.resource.data.role in ['ATTENDEE', 'PRIMARY_ADMIN']
            || isEventAdmin(eventId)
          );
        allow update: if signedIn()
          && (
            isEventAdmin(eventId)
            || request.auth.uid == userId
              && request.resource.data.role == resource.data.role
              && request.resource.data.blockedAt == resource.data.blockedAt
            || request.auth.uid == userId
              && resource.data.get('blockedAt', null) != null
              && request.resource.data.keys().hasAll([
                'userId', 'displayName', 'role', 'joinedAt', 'blockedAt', 'leftAt',
                'accessMethod', 'checkedInAt'
              ])
              && request.resource.data.keys().hasOnly([
                'userId', 'displayName', 'role', 'joinedAt', 'blockedAt', 'leftAt',
                'accessMethod', 'checkedInAt'
              ])
              && request.resource.data.userId == userId
              && request.resource.data.displayName is string
              && request.resource.data.displayName.size() > 0
              && request.resource.data.displayName.size() <= 24
              && request.resource.data.role == 'ATTENDEE'
              && request.resource.data.joinedAt is int
              && request.resource.data.blockedAt == null
              && request.resource.data.leftAt == null
              && request.resource.data.accessMethod == null
              && request.resource.data.checkedInAt == null
              && !(userId in eventData(eventId).memberIds)
              && userId in getAfter(/databases/$(database)/documents/events/$(eventId)).data.memberIds
              && acceptingFreshInvite(eventId, userId)
          );
        allow delete: if isEventAdmin(eventId);
      }

      match /announcements/{announcementId} {
        allow read: if signedIn() && isPublicEvent(eventId)
          || accountSignedIn() && isEventMember(eventId);
        allow create, update: if isEventAdmin(eventId)
          && request.resource.data.adminId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.signature is string
          && request.resource.data.signature.size() > 0;
        allow delete: if isEventAdmin(eventId);
      }

      match /discussionThreads/{threadId} {
        allow read: if isActiveEventMember(eventId);
        allow create: if discussionWritable(eventId)
          && validDiscussionRoot(request.resource.data, eventId, threadId);
        allow update: if validDiscussionLikeCountUpdate(eventId, threadId)
          || validDiscussionReplyCounterIncrement(eventId, threadId)
          || validDiscussionAdminReplyCountUpdate(eventId)
          || validDiscussionSoftDelete(eventId)
          || validDiscussionAdminRemoval(eventId);
        allow delete: if isEventAdmin(eventId);

        match /comments/{commentId} {
          allow read: if isActiveEventMember(eventId);
          allow create: if discussionWritable(eventId)
            && validDiscussionReply(request.resource.data, eventId, threadId, commentId);
          allow update: if validDiscussionLikeCountUpdate(eventId, commentId)
            || validDiscussionSoftDelete(eventId)
            || validDiscussionAdminRemoval(eventId);
          allow delete: if isEventAdmin(eventId);
        }
      }

      match /discussionLikes/{likeId} {
        allow read: if isEventAdmin(eventId)
          || isActiveEventMember(eventId) && resource.data.userId == request.auth.uid;
        allow create: if validDiscussionLikeCreate(request.resource.data, eventId, likeId);
        allow update: if false;
        allow delete: if isEventAdmin(eventId) || validDiscussionLikeDelete(eventId);
      }
    }

    match /eventInvitations/{invitationId} {
      allow read: if accountSignedIn()
        && (resource.data.recipientUid == request.auth.uid || isEventAdmin(resource.data.eventId));
      allow create: if accountSignedIn()
        && request.resource.data.keys().hasOnly([
          'eventId', 'eventTitle', 'inviterUid', 'inviterName', 'recipientUid',
          'recipientName', 'recipientUsername', 'startsAt', 'endsAt', 'createdAt',
          'expiresAt', 'status'
        ])
        && invitationId == inviteId(request.resource.data.eventId, request.resource.data.recipientUid)
        && request.resource.data.inviterUid == request.auth.uid
        && isEventAdmin(request.resource.data.eventId)
        && eventData(request.resource.data.eventId).visibility == 'PRIVATE'
        && request.resource.data.recipientUid != request.auth.uid
        && exists(/databases/$(database)/documents/accountCards/$(request.resource.data.recipientUid))
        && request.resource.data.status == 'PENDING'
        && request.resource.data.expiresAt == eventData(request.resource.data.eventId).endsAt;
      allow update: if accountSignedIn() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && resource.data.status == 'PENDING'
          && (
            resource.data.recipientUid == request.auth.uid
              && request.resource.data.status in ['ACCEPTED', 'DECLINED']
            || isEventAdmin(resource.data.eventId)
              && request.resource.data.status == 'REVOKED'
          )
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && isEventAdmin(resource.data.eventId)
          && resource.data.status == 'ACCEPTED'
          && request.resource.data.status == 'REVOKED'
          && (
            !(resource.data.recipientUid in eventData(resource.data.eventId).memberIds)
            || !(resource.data.recipientUid in getAfter(
              /databases/$(database)/documents/events/$(resource.data.eventId)
            ).data.memberIds)
          )
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && resource.data.recipientUid == request.auth.uid
          && resource.data.status == 'ACCEPTED'
          && request.resource.data.status == 'REVOKED'
          && request.auth.uid in eventData(resource.data.eventId).memberIds
          && !(request.auth.uid in getAfter(
            /databases/$(database)/documents/events/$(resource.data.eventId)
          ).data.memberIds)
        || isEventAdmin(resource.data.eventId)
          && resource.data.status in ['PENDING', 'ACCEPTED', 'DECLINED', 'REVOKED']
          && (resource.data.status != 'ACCEPTED'
            || !(resource.data.recipientUid in eventData(resource.data.eventId).memberIds))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'eventTitle', 'inviterUid', 'inviterName', 'recipientName',
            'recipientUsername', 'startsAt', 'endsAt', 'createdAt', 'expiresAt', 'status'
          ])
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.recipientUid == resource.data.recipientUid
          && invitationId == inviteId(resource.data.eventId, resource.data.recipientUid)
          && request.resource.data.inviterUid == request.auth.uid
          && eventData(resource.data.eventId).visibility == 'PRIVATE'
          && request.resource.data.status == 'PENDING'
          && request.resource.data.expiresAt == eventData(resource.data.eventId).endsAt
      );
      allow delete: if isEventAdmin(resource.data.eventId);
    }
  }
}
